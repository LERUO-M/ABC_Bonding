# Copy to .env and fill in the values for your target network.
# When using `npm run start:all` from the repo root, this file is generated
# for you automatically and does not need to be edited by hand.

VITE_RPC_URL=http://127.0.0.1:8545
VITE_CHAIN_ID=31337
VITE_CHAIN_NAME=Localhost

# Required: BondDepository and Staking contract addresses
VITE_BOND_DEPOSITORY=
VITE_STAKING=

# Optional: auto-read from chain if omitted
VITE_TIME_TOKEN=
VITE_PRINCIPLE_TOKEN=
VITE_MEMO_TOKEN=
