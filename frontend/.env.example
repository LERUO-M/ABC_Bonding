# RPC endpoint for your chain (must match wallet network)
VITE_RPC_URL=http://127.0.0.1:8545

# Chain ID (31337 = local Hardhat/Anvil, 43114 = Avalanche, etc.)
VITE_CHAIN_ID=31337

# Optional display name in header
VITE_CHAIN_NAME=Localhost

# Deployed contract addresses (fill after deploy)
VITE_BOND_DEPOSITORY=0x0000000000000000000000000000000000000000
VITE_STAKING=0x0000000000000000000000000000000000000000

# Optional overrides (auto-read from BondDepository if omitted)
# VITE_TIME_TOKEN=
# VITE_PRINCIPLE_TOKEN=
# VITE_MEMO_TOKEN=
